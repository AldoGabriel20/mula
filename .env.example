# Copy to .env and adjust. The API reads real environment variables (it does not load this
# file itself) — `make` targets and `set -a; source .env; set +a` both work.
# Every variable below is actually read by the code.

# ---- API (api/) ---------------------------------------------------------------------------
# dev | prod. Outside dev the API REFUSES to start without the two secrets below.
APP_ENV=dev
API_ADDR=:8080
# Matches docker-compose.yml (host port 15432).
DATABASE_URL=postgres://mula:mula@localhost:15432/mula?sslmode=disable
# Browser origin allowed by CORS (the Next dev server).
CORS_ORIGIN=http://localhost:3000
# Web origin used in links we email (guest invitations, team invites). Defaults to CORS_ORIGIN.
# PUBLIC_BASE_URL=http://localhost:3000
# Reverse proxies whose X-Forwarded-For header we believe (comma-separated CIDRs/IPs).
# REQUIRED when the API runs behind Next's /api proxy, a load balancer or a CDN — otherwise every
# user appears to come from the proxy's IP and shares ONE rate-limit bucket (site-wide lockouts).
# Leave empty only when clients connect to the API directly. Never use 0.0.0.0/0 (lets anyone forge
# their IP). Local dev with `make web` proxying to the API: 127.0.0.1, ::1
TRUSTED_PROXIES=127.0.0.1,::1

# Local media blob directory (a Storage interface; S3 later).
MEDIA_DIR=./var/media

# Template catalog (manifests, palettes, fonts, music, section content schemas). The API validates it at
# start and refuses to run on a broken one. Relative to the API working directory.
CATALOG_DIR=../catalog

# REQUIRED when APP_ENV != dev. Generate each with:  openssl rand -hex 32
# In dev, empty = an insecure built-in key (logged as a warning).
PAYMENT_WEBHOOK_SECRET=
MEDIA_SIGNING_SECRET=

# Integration tests (go test ./...) run against this DB; they are skipped when unset.
# Use a throwaway database: the tests TRUNCATE users CASCADE.
TEST_DATABASE_URL=postgres://mula:mula@localhost:15432/mula_test?sslmode=disable

# ---- Web (web/) ---------------------------------------------------------------------------
# Where Next proxies /api/v1/* and where server components call the API.
API_ORIGIN=http://localhost:8080
# Absolute site URL for sitemap/robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 to run the full-stack Playwright flow (needs api + postgres running).
E2E_FULL_STACK=

# Dev only: raise the per-IP rate limit on login and guest endpoints so browser tests (all from 127.0.0.1) are not throttled.
# Ignored unless APP_ENV=dev. Leave unset for the production default (30/min, burst 10).
# DEV_AUTH_RATE_PER_MIN=6000
