{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mula.app/catalog/manifest.schema.json",
  "title": "Mula template manifest v1 (docs/17 §5). Enforced by `go run ./cmd/templates validate`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "slug",
    "name",
    "kind",
    "status",
    "access",
    "category",
    "eventTypes",
    "tags",
    "position",
    "palette",
    "marketing",
    "sections",
    "capabilities",
    "tokens",
    "customizable",
    "thumbnail"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "kind": {
      "enum": [
        "coded",
        "themed"
      ]
    },
    "renderer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*$"
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "retired"
      ]
    },
    "access": {
      "enum": [
        "free",
        "premium"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "eventTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z_]*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      }
    },
    "position": {
      "type": "integer",
      "minimum": 0
    },
    "palette": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "marketing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desc",
        "style",
        "mood"
      ],
      "properties": {
        "desc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "style": {
          "type": "string",
          "maxLength": 30
        },
        "mood": {
          "type": "string",
          "maxLength": 30
        },
        "demo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route"
          ],
          "properties": {
            "route": {
              "type": "string",
              "pattern": "^/demo/[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "hero",
              "opening",
              "story",
              "schedule",
              "gallery",
              "gift",
              "rsvp",
              "wishes",
              "music",
              "closing"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "hiddenUntilFilled": {
            "type": "boolean"
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "music",
        "gallery",
        "wishes",
        "rsvp",
        "gift",
        "timezone",
        "multiMoment",
        "languages",
        "needsWebGL",
        "reducedMotion"
      ],
      "properties": {
        "music": {
          "type": "boolean"
        },
        "gallery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max"
          ],
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "wishes": {
          "type": "boolean"
        },
        "rsvp": {
          "type": "boolean"
        },
        "gift": {
          "type": "boolean"
        },
        "timezone": {
          "type": "boolean"
        },
        "multiMoment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max"
          ],
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "en",
              "id",
              "ms"
            ]
          }
        },
        "needsWebGL": {
          "type": "boolean"
        },
        "reducedMotion": {
          "enum": [
            "static",
            "calm"
          ]
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "font",
        "motion"
      ],
      "properties": {
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bg",
            "surface",
            "ink",
            "inkSoft",
            "muted",
            "accent",
            "accentSoft",
            "line",
            "danger",
            "onAccent"
          ],
          "properties": {
            "bg": {
              "$ref": "#/$defs/hex"
            },
            "surface": {
              "$ref": "#/$defs/hex"
            },
            "ink": {
              "$ref": "#/$defs/hex"
            },
            "inkSoft": {
              "$ref": "#/$defs/hex"
            },
            "muted": {
              "$ref": "#/$defs/hex"
            },
            "accent": {
              "$ref": "#/$defs/hex"
            },
            "accentSoft": {
              "$ref": "#/$defs/hex"
            },
            "line": {
              "$ref": "#/$defs/hex"
            },
            "danger": {
              "$ref": "#/$defs/hex"
            },
            "onAccent": {
              "$ref": "#/$defs/hex"
            }
          }
        },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "body",
            "script"
          ],
          "properties": {
            "display": {
              "$ref": "#/$defs/id"
            },
            "body": {
              "$ref": "#/$defs/id"
            },
            "script": {
              "$ref": "#/$defs/id"
            },
            "mono": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "enum": [
                "full",
                "calm",
                "off"
              ]
            },
            "durationScale": {
              "type": "number",
              "minimum": 0.6,
              "maximum": 1.4
            }
          }
        },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/hex"
          }
        }
      }
    },
    "customizable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "fontPairings",
        "tokens",
        "motion"
      ],
      "properties": {
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "fontPairings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z]+$"
          }
        },
        "motion": {
          "type": "array",
          "items": {
            "enum": [
              "full",
              "calm",
              "off"
            ]
          }
        }
      }
    },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block"
        ],
        "properties": {
          "block": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "visibleWhen": {
            "enum": [
              "always",
              "filled"
            ]
          }
        }
      }
    },
    "thumbnail": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+\\.webp$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsGzKb": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "thumbnailMobile": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+\\.webp$"
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  }
}
